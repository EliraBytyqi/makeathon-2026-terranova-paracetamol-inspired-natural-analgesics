# Python
.venv/
__pycache__/
*.pyc

# Empty local clone of this repo
makeathon-2026-terranova-paracetamol-inspired-natural-analgesics/

# pyvis writes its vendored JS next to the working directory when kg.py runs.
# The copy that matters is results/lib, which kg.py places beside the graph.
src/lib/

# Experiment models: large, regenerable by scripts/experiment_*.py, and not
# part of the deployed pipeline. The production models in models/ are tracked.
models/experiments/

# Raw third-party bulk downloads. Re-fetched by the scripts that use them
# (validate_pubchem.py, experiment_npass.py); the derived results ARE tracked.
data/external/npass/
data/external/pubchem/
data/interim/bioactivity_with_npass.csv

# Presentation documents are distributed separately, not through the repo.
docs/

# Runtime logs written by the pipeline and the dashboard.
results/*.log

# Local snapshots taken before a retrain. Regenerable; large.
backup_*/
*.bak
*.prev

# Cached third-party downloads. Re-fetched on demand by the scripts that
# use them; the derived results under results/ ARE tracked.
data/external/tox21/
data/external/hepatic_cache/
data/external/dilirank/

# Raw and intermediate data: large, and regenerated by the pipeline stages
# that produce them. The derived results under results/ ARE tracked, so a
# fresh clone can run the dashboard without re-downloading anything.
data/raw/
data/interim/
data/processed/np_library.csv
data/external/lotus/

# The full scored screen is tracked in gzipped form (results/screening_all.csv.gz).
results/screening_all.csv
